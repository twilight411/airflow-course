# ===== DeepSeek 大模型（OpenAI 兼容协议）=====
# 申请地址: https://platform.deepseek.com/  创建 API Key 后填入；留空则使用规则兜底
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== Airflow REST API（与 docker-compose 中管理员账号一致）=====
# 网关 REST 连接用 127.0.0.1，避免 Windows 下 localhost 优先走 IPv6 导致每次连接等待约 20 秒
AIRFLOW_BASE_URL=http://127.0.0.1:18080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow

# ===== 轮询参数 =====
POLL_INTERVAL=3
WAIT_TIMEOUT=180
