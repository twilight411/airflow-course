# =====================================================================
# Airflow 课程作业环境变量模板 —— 复制为 .env 后填写真实值
# 本文件可提交；.env 已在 .gitignore 中排除，不要提交真实密钥
# =====================================================================

# ---------- 1. Airflow 基础 ----------
AIRFLOW_UID=50000
AIRFLOW_IMAGE_NAME=apache/airflow:3.3.2

# Fernet Key 用于加密连接/变量中的敏感信息；本地 .env 保留真实值，模板不提交密钥。
# 可在已安装 Airflow/cryptography 的环境中用 Fernet.generate_key().decode() 生成。
FERNET_KEY=
# 本地 .env 保留真实 JWT Secret；模板不提交密钥，可自行随机生成足够长度的字符串。
AIRFLOW__API_AUTH__JWT_SECRET=

# Web/REST 管理员账号（airflow-init 自动创建）
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ---------- 2. 邮件 Skill 配置（容器内 DAG 任务读取） ----------
# 支持 QQ: smtp.qq.com:465(ssl)；163: smtp.163.com:465(ssl)；
# Gmail: smtp.gmail.com:587(starttls)；企业邮箱按其文档填写。
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
# ssl  /  starttls  /  none
EMAIL_SMTP_SECURE=ssl
# 发件邮箱（必须与 EMAIL_SMTP_USER 一致）
EMAIL_SMTP_USER=
# 邮箱 SMTP 授权码（不是登录密码！在邮箱“设置-账户-开启SMTP服务”页面生成）
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_FROM=
# 默认收件人，多个用英文逗号分隔；DAG conf 可覆盖
EMAIL_DEFAULT_TO=
# true=只渲染邮件并落盘到 output/drafts 模拟发送（演示稳定、不触达真实收件箱）
# 填好上面三项真实配置后改为 false 即走真实 SMTP 发送
EMAIL_DRY_RUN=true
EMAIL_OUTPUT_DIR=/opt/airflow/output

# ---------- 3. LLM 网关配置（宿主机 llm_bridge 读取，复制到 llm_bridge/.env） ----------
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
AIRFLOW_BASE_URL=http://127.0.0.1:18080
AIRFLOW_USERNAME=airflow
AIRFLOW_PASSWORD=airflow
